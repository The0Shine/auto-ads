# =============================================================================
# Auto-Ads Platform — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=autoads
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=autoads

# ─── TimescaleDB (Metrics) ───────────────────────────────────────────────────
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5433
TIMESCALE_USER=autoads
TIMESCALE_PASSWORD=your_secure_password_here
TIMESCALE_DB=autoads_metrics

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=autoads_dev_jwt_secret_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Facebook Marketing API ──────────────────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:3000/auth/oauth/facebook/callback

# ─── Google Ads API ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# ─── TikTok Marketing API ────────────────────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/oauth/tiktok/callback

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@autoads.io

# ─── Object Storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoads-creatives
S3_REGION=us-east-1
